{
  "name": "linux-buddy",
  "version": "0.1.0",
  "description": "A safe, Linux-first floating desktop assistant",
  "desktopName": "linux-buddy.desktop",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron --no-sandbox .\"",
    "build": "tsc -p tsconfig.node.json && vite build && electron-builder --linux dir",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:sandboxed": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:build": "tsc -p tsconfig.node.json",
    "desktop:install": "pnpm desktop:build && python3 scripts/install-desktop.py",
    "desktop:status": "python3 scripts/desktop-command.py",
    "stt:setup": "python3 scripts/setup-stt.py",
    "start:desktop": "python3 scripts/start-desktop.py",
    "test:native": "pnpm desktop:build && python3 tests/native/run.py",
    "test:native:ui": "pnpm build && python3 tests/native/run.py --ui",
    "test:native:agent": "pnpm build && python3 tests/native/run.py --agent",
    "test:sessions:agent": "pnpm desktop:build && node tests/native/sessions.mjs"
  },
  "build": {
    "appId": "dev.linuxbuddy.app",
    "productName": "Linux Buddy",
    "asar": true,
    "publish": null,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "syncDesktopName": true
    },
    "extraResources": [
      {
        "from": "native/desktop-client.py",
        "to": "desktop-client.py"
      },
      {
        "from": "native/parakeet-worker.py",
        "to": "parakeet-worker.py"
      }
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "lucide-react": "^1.31.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Linux Buddy Contributors <noreply@linux-buddy.local>"
}
