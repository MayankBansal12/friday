# Required for agent runs. Store this as a secret; do not commit a real value.
OPENCODE_API_KEY=

# Speech recognition: Groq Whisper when a key is present; otherwise local Parakeet.
# An explicit provider forces one engine. Groq sends each utterance to the cloud
# and needs no local model; parakeet stays fully offline via pnpm stt:setup.
GROQ_API_KEY=
# LINUX_BUDDY_STT_PROVIDER=groq
# LINUX_BUDDY_GROQ_STT_MODEL=whisper-large-v3-turbo
# Whisper auto-detects language when unset; a hint pins one (e.g. hi for Hindi).
# LINUX_BUDDY_GROQ_STT_LANGUAGE=hi

# TypeSafe Jev judges speech heard while Friday is busy (interrupt or let it pass).
# Without a key, any such speech replaces the current turn. LINUX_BUDDY_TURN_GATE=off disables it.
TYPESAFE_API_KEY=

# Optional runtime overrides.
LINUX_BUDDY_MODEL=gpt-6-luna
LINUX_BUDDY_WAKE_WORD=Friday
# On-device "Hey <wake word>" detector (pnpm wake:setup). Until it fires, no audio is
# transcribed or uploaded. Off falls back to transcribing all speech.
# LINUX_BUDDY_WAKE_MODEL=/absolute/path/to/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01
# LINUX_BUDDY_WAKE_DETECTOR=off
# LINUX_BUDDY_WAKE_SCORE=1.5
# LINUX_BUDDY_WAKE_THRESHOLD=0.25
# Defaults to Parakeet V3 already downloaded by Handy under XDG_DATA_HOME.
# LINUX_BUDDY_STT_MODEL=/absolute/path/to/parakeet-tdt-0.6b-v3-int8
# LINUX_BUDDY_STT_PYTHON=/absolute/path/to/stt-venv/bin/python
# LINUX_BUDDY_STT_THREADS=4
# LINUX_BUDDY_PI_BIN=pi
# Computer control uses existing Codex authentication; no separate API key needed.
# LINUX_BUDDY_CODEX_BIN=codex
# LINUX_BUDDY_COMPUTER_MODEL=gpt-6-sol
# LINUX_BUDDY_FFMPEG_BIN=ffmpeg

# Voice replies: rumik is selected when a key is present; otherwise local espeak.
# Set espeak explicitly to use the offline voice. Hosted errors never auto-fallback.
# LINUX_BUDDY_TTS_PROVIDER=rumik
RUMIK_API_KEY=
# Rumik Silk mulberry streaming; requires the tts:stream scope and pw-cat.
# RUMIK_VOICE=ira
# RUMIK_VOICE_DESCRIPTION=A warm female voice with an Indian accent and conversational pacing.

# Optional realtime audio transport through a LiveKit room. Leave all three unset to use the
# direct microphone and pw-cat playback. Set all or none; the key/secret stay in the main process.
# Only wss:// URLs, or ws:// on localhost, are accepted. Recognition follows the
# configured STT provider (Groq or Parakeet).
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_ROOM=friday
